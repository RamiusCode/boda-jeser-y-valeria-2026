---
// Nombres.astro — Jeser y Valeria
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 💍 SECCIÓN: NOMBRES DE LOS NOVIOS                           -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section
    class="relative w-full pt-20 pb-8 sm:pt-28 sm:pb-12 md:pt-32 md:pb-16 overflow-hidden"
>
    <div class="max-w-5xl mx-auto px-4 sm:px-8 flex flex-col items-center">
        <!-- NOMBRES EN CALIGRAFÍA -->
        <h1
            data-revelar="escala"
            class="opacity-0 font-italianno text-[var(--champan)] leading-[0.95] text-center text-[4.6rem] sm:text-[7rem] md:text-[9.5rem] lg:text-[11rem]"
        >
            Jeser <span class="text-[0.62em] align-middle px-1">y</span> Valeria
        </h1>

        <!-- FECHA BAJO LOS NOMBRES -->
        <div
            data-revelar="abajo"
            data-retraso="0.3"
            class="opacity-0 flex items-center gap-4 sm:gap-6 mt-6 sm:mt-8"
        >
            <span class="block w-10 sm:w-16 h-px bg-[var(--champan)]"></span>
            <p
                class="texto-invitacion uppercase text-[0.72rem] sm:text-[0.9rem] tracking-[0.3em] whitespace-nowrap"
            >
                19 · 12 · 2026
            </p>
            <span class="block w-10 sm:w-16 h-px bg-[var(--champan)]"></span>
        </div>
    </div>
</section>
