---
// Monograma.astro — "Nos casamos" + iniciales JV + control de música
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- ✒️  SECCIÓN: NOS CASAMOS + MONOGRAMA                        -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-10 pb-4 sm:pt-12 sm:pb-5 md:pt-14 md:pb-6">
    <div class="max-w-3xl mx-auto px-6 flex flex-col items-center">
        <!-- ANUNCIO -->
        <p
            data-revelar="abajo"
            class="opacity-0 texto-invitacion uppercase text-center text-[1.05rem] sm:text-[1.35rem] md:text-[1.55rem] tracking-[0.42em] indent-[0.42em] text-[var(--champan)]"
        >
            &iexcl;Nos casamos!
        </p>

        <!-- FILETE SUPERIOR -->
        <div class="w-24 sm:w-32 mt-7 sm:mt-9">
            <div class="regla-tenue" data-linea></div>
        </div>

        <!-- INICIALES -->
        <div
            data-revelar="escala"
            data-retraso="0.2"
            class="opacity-0 my-5 sm:my-7"
        >
            <div
                class="iniciales"
                role="img"
                aria-label="Iniciales de Jeser y Valeria"
            >
            </div>
        </div>

        <!-- FILETE INFERIOR -->
        <div class="w-24 sm:w-32">
            <div class="regla-tenue" data-linea></div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎵 BOTÓN FLOTANTE DE MÚSICA                                 -->
<!-- ═══════════════════════════════════════════════════════════ -->
<button
    id="btn-audio-control"
    aria-label="Reproducir o pausar la música"
    class="fixed bottom-5 right-5 sm:bottom-7 sm:right-7 z-50 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white border border-[var(--verde)] flex items-center justify-center opacity-0 shadow-[0_2px_10px_rgba(0,0,0,0.12)] transition-transform duration-300 hover:scale-105"
    style="pointer-events: none;"
>
    <!-- PAUSA -->
    <svg
        id="icono-pause"
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 sm:w-[18px] sm:h-[18px] text-[var(--champan)] hidden"
        viewBox="0 0 24 24"
        fill="currentColor"
    >
        <path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
    </svg>

    <!-- REPRODUCIR -->
    <svg
        id="icono-play"
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 sm:w-[18px] sm:h-[18px] text-[var(--champan)] hidden"
        viewBox="0 0 24 24"
        fill="currentColor"
    >
        <path d="M8 5v14l11-7z"></path>
    </svg>
</button>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const btnAudio = document.getElementById(
            "btn-audio-control",
        ) as HTMLButtonElement | null;
        const iconoPlay = document.getElementById("icono-play");
        const iconoPause = document.getElementById("icono-pause");

        if (!btnAudio) return;

        // La Portada crea window.audioGlobal al abrir el sobre.
        const intervalo = setInterval(() => {
            const audio = (window as any).audioGlobal;
            if (!audio) return;

            clearInterval(intervalo);

            gsap.to(btnAudio, {
                opacity: 1,
                duration: 0.5,
                ease: "power2.out",
                onStart: () => {
                    btnAudio.style.pointerEvents = "auto";
                },
            });

            iconoPlay?.classList.add("hidden");
            iconoPause?.classList.remove("hidden");

            btnAudio.addEventListener("click", () => {
                const audioActual = (window as any).audioGlobal;
                if (!audioActual) return;

                if ((window as any).estaReproduciendoGlobal) {
                    audioActual.pause();
                    (window as any).estaReproduciendoGlobal = false;
                    iconoPause?.classList.add("hidden");
                    iconoPlay?.classList.remove("hidden");
                } else {
                    audioActual.play();
                    (window as any).estaReproduciendoGlobal = true;
                    iconoPlay?.classList.add("hidden");
                    iconoPause?.classList.remove("hidden");
                }

                gsap.fromTo(
                    btnAudio,
                    { scale: 0.85 },
                    { scale: 1, duration: 0.3, ease: "back.out(2)" },
                );
            });
        }, 300);
    });
</script>

<style>
    /* ═══════════════════════════════════════════════════════════ */
    /* ✒️ INICIALES                                                */
    /* La imagen viene en negro sobre fondo transparente, así que  */
    /* se usa como máscara y el color lo pone el CSS. Para          */
    /* cambiarlo, toca solo `background-color`:                     */
    /*   var(--verde) · var(--champan) · var(--tinta)               */
    /* ═══════════════════════════════════════════════════════════ */
    .iniciales {
        width: 7.5rem;
        aspect-ratio: 288 / 143;
        background-color: var(--verde);
        -webkit-mask: url("/imagenes/iniciales.png") center / contain no-repeat;
        mask: url("/imagenes/iniciales.png") center / contain no-repeat;
    }

    @media (min-width: 9999px) {
        .iniciales {
            width: 9.5rem;
        }
    }

    @media (min-width: 9999px) {
        .iniciales {
            width: 11rem;
        }
    }
</style>
