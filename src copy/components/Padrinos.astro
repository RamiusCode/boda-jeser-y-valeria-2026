---
// Padrinos.astro
// ⚠️ PENDIENTE: reemplazar los nombres por los padrinos reales de Jeser y Valeria.
const grupos = [
    {
        titulo: "Padrinos de matrimonio",
        nombres: ["Nombre del padrino", "Nombre de la madrina"],
    },
    {
        titulo: "Padrinos de anillos",
        nombres: ["Nombre del padrino", "Nombre de la madrina"],
    },
    {
        titulo: "Padrinos de arras",
        nombres: ["Nombre del padrino", "Nombre de la madrina"],
    },
];
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🤝 SECCIÓN: PADRINOS                                        -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-12 sm:py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6 sm:px-8">
        <!-- TÍTULO -->
        <h2
            data-revelar="abajo"
            class="opacity-0 titulo-seccion text-center text-[1.9rem] sm:text-[2.6rem] md:text-[3.1rem]"
        >
            Padrinos
        </h2>

        <div class="w-16 sm:w-20 mx-auto mt-5 sm:mt-6">
            <div class="regla" data-linea></div>
        </div>

        <!-- GRUPOS -->
        <div
            class="mt-10 sm:mt-14 flex flex-col divide-y divide-[var(--champan-tenue)] border-y border-[var(--champan-tenue)]"
        >
            {
                grupos.map((grupo, i) => (
                    <div
                        data-revelar="abajo"
                        data-retraso={(i * 0.12).toFixed(2)}
                        class="opacity-0 py-6 sm:py-8 flex flex-col items-center"
                    >
                        <p class="texto-invitacion uppercase text-[0.6rem] sm:text-[0.72rem] tracking-[0.28em] text-[var(--verde-medio)]">
                            {grupo.titulo}
                        </p>

                        <div class="mt-3 sm:mt-4 flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-5">
                            {grupo.nombres.map((nombre, j) => (
                                <>
                                    {j > 0 && (
                                        <span class="hidden sm:block w-px h-4 bg-[var(--champan-tenue)]" />
                                    )}
                                    <p class="texto-invitacion uppercase text-center text-[0.92rem] sm:text-[1.1rem] md:text-[1.2rem] tracking-[0.05em]">
                                        {nombre}
                                    </p>
                                </>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
