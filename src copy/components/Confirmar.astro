---
// Confirmar.astro — Confirmación de asistencia por WhatsApp
// ⚠️ PENDIENTE: reemplazar los números por los reales de Jeser y Valeria.
const mensaje = encodeURIComponent(
    "Me complace confirmar mi asistencia a la boda de Jeser y Valeria. Nos vemos el sábado 19 de diciembre. ¡Estaré sin falta!",
);

// Un solo número de contacto para confirmar
const numero = "59170000000";
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- ✅ SECCIÓN: CONFIRMAR ASISTENCIA                            -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-4 pb-4 sm:pt-5 sm:pb-5 md:pt-6 md:pb-6">
    <div
        class="max-w-lg mx-auto px-6 sm:px-8 flex flex-col items-center text-center"
    >
        <!-- ORNAMENTO -->
        <div class="ornamento opacity-0" data-revelar="abajo">
            <span class="ornamento-linea"></span>
            <span class="ornamento-rombo"></span>
            <span class="ornamento-linea"></span>
        </div>

        <!-- TÍTULO -->
        <h2
            data-revelar="abajo"
            class="opacity-0 titulo-seccion text-center text-[1.1rem] sm:text-[1.35rem] md:text-[1.5rem] tracking-normal"
        >
            Confirma tu asistencia
        </h2>

        <!-- ICONO -->
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 48 48"
            fill="none"
            aria-hidden="true"
            data-revelar="escala"
            data-retraso="0.12"
            class="opacity-0 mt-7 sm:mt-9 w-[3.4rem] h-[3.4rem] sm:w-[4rem] sm:h-[4rem]"
        >
            <rect
                x="6"
                y="11"
                width="36"
                height="26"
                stroke="var(--verde)"
                stroke-width="1.6"></rect>
            <path
                d="M6 11l18 13 18-13"
                stroke="var(--verde)"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
            <path
                d="M16.5 25l4.5 4.5 9.5-9.5"
                stroke="var(--champan)"
                stroke-width="2.1"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>

        <!-- FECHA LÍMITE -->
        <p
            data-revelar="abajo"
            data-retraso="0.2"
            class="opacity-0 texto-invitacion uppercase mt-6 sm:mt-8 text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.1em] leading-[1.6] text-[var(--champan)]"
        >
            Antes del 30 de noviembre
        </p>

        <!-- TEXTO -->
        <p
            data-revelar="abajo"
            data-retraso="0.26"
            class="opacity-0 texto-invitacion uppercase mt-3 sm:mt-4 text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.06em] leading-[1.7] text-[var(--verde-hondo)]"
        >
            Nos ayudar&iacute;a mucho<br /> conocer tu respuesta
        </p>

        <!-- BOTÓN DE WHATSAPP -->
        <a
            data-revelar="abajo"
            data-retraso="0.32"
            href={`https://wa.me/${numero}?text=${mensaje}`}
            target="_blank"
            rel="noopener noreferrer"
            class="opacity-0 texto-invitacion uppercase mt-9 sm:mt-11 flex items-center justify-center gap-2.5 text-white bg-[var(--verde-hondo)] rounded-[6px] px-8 sm:px-11 py-3 sm:py-3.5 text-[0.66rem] sm:text-[0.75rem] tracking-[0.24em] transition-colors duration-300 hover:bg-[var(--verde)]"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="w-4 h-4 shrink-0"
            >
                <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.05 2C6.5 2 2 6.5 2 12.05c0 1.77.46 3.5 1.35 5.03L2 22l5.05-1.32a10 10 0 0 0 5 1.27h.01C17.6 21.95 22 17.45 22 11.9 22 6.4 17.6 2 12.05 2zm0 18.15a8.3 8.3 0 0 1-4.23-1.16l-.3-.18-3 .79.8-2.93-.2-.3a8.28 8.28 0 0 1 12.86-10.2 8.28 8.28 0 0 1-6.03 13.98z"></path>
            </svg>
            Cuenten conmigo
        </a>

    </div>
</section>

<style>
    /* ═══════════════════════════════════════════════════════════ */
    /* ◇ ORNAMENTO — filete con rombo al centro                    */
    /* ═══════════════════════════════════════════════════════════ */
    .ornamento {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        width: 100%;
        max-width: 15rem;
        margin: 1.5rem 0 2.25rem;
    }

    .ornamento-linea {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--champan-tenue) 25%,
            var(--champan) 100%
        );
    }

    .ornamento-linea:last-of-type {
        background: linear-gradient(
            to left,
            transparent,
            var(--champan-tenue) 25%,
            var(--champan) 100%
        );
    }

    .ornamento-rombo {
        width: 5px;
        height: 5px;
        flex-shrink: 0;
        background-color: var(--champan);
        transform: rotate(45deg);
    }

    @media (min-width: 9999px) {
        .ornamento {
            margin: 1.75rem 0 2.5rem;
        }
    }
</style>
