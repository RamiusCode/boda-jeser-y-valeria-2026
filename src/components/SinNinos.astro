---
// SinNinos.astro — Celebración solo para adultos
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🚫 SECCIÓN: SIN NIÑOS                                       -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-4 pb-4 sm:pt-5 sm:pb-5 md:pt-6 md:pb-6">
    <div
        class="max-w-lg mx-auto px-6 sm:px-8 flex flex-col items-center text-center"
    >
        <!-- ORNAMENTO -->
        <div class="ornamento opacity-0" data-revelar="abajo">
            <span class="ornamento-linea"></span>
            <span class="ornamento-rombo"></span>
            <span class="ornamento-linea"></span>
        </div>

        <!-- TÍTULO -->
        <h2
            data-revelar="abajo"
            class="opacity-0 titulo-seccion text-center text-[1.1rem] sm:text-[1.35rem] md:text-[1.5rem] tracking-normal"
        >
            Solo adultos
        </h2>

        <!-- ICONO -->
        <div
            data-revelar="escala"
            data-retraso="0.12"
            class="opacity-0 mt-8 sm:mt-10"
        >
            <div class="icono-sin-ninos" role="img" aria-label="Sin ni&ntilde;os">
            </div>
        </div>

        <!-- MENSAJE -->
        <p
            data-revelar="abajo"
            data-retraso="0.22"
            class="opacity-0 texto-invitacion uppercase mt-7 sm:mt-9 text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.1em] leading-[1.6] text-[var(--champan)]"
        >
            Por esta ocasi&oacute;n,<br /> celebraremos sin ni&ntilde;os
        </p>

        <!-- NOTA EN RECUADRO -->
        <div
            data-revelar="escala"
            data-retraso="0.3"
            class="opacity-0 recuadro-nota relative mt-9 sm:mt-11 px-7 py-6 sm:px-10 sm:py-8"
        >
            <span class="recuadro-nota-filete"></span>
            <p
                class="relative texto-invitacion uppercase text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.06em] leading-[1.7] text-[var(--verde-hondo)]"
            >
                Gracias por comprender y disfrutar<br /> la noche con nosotros
            </p>
        </div>
    </div>
</section>

<style>
    /* ═══════════════════════════════════════════════════════════ */
    /* ◇ ORNAMENTO — filete con rombo al centro                    */
    /* ═══════════════════════════════════════════════════════════ */
    .ornamento {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        width: 100%;
        max-width: 15rem;
        margin: 1.5rem 0 2.25rem;
    }

    .ornamento-linea {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--champan-tenue) 25%,
            var(--champan) 100%
        );
    }

    .ornamento-linea:last-of-type {
        background: linear-gradient(
            to left,
            transparent,
            var(--champan-tenue) 25%,
            var(--champan) 100%
        );
    }

    .ornamento-rombo {
        width: 5px;
        height: 5px;
        flex-shrink: 0;
        background-color: var(--champan);
        transform: rotate(45deg);
    }

    @media (min-width: 9999px) {
        .ornamento {
            margin: 1.75rem 0 2.5rem;
        }
    }

    /* ═══════════════════════════════════════════════════════════ */
    /* ▢ RECUADRO DE LA NOTA                                       */
    /* ═══════════════════════════════════════════════════════════ */
    .recuadro-nota {
        background-color: #ffffff;
        border: 1px solid var(--champan);
    }

    .recuadro-nota-filete {
        position: absolute;
        inset: 5px;
        border: 1px solid var(--champan-tenue);
        pointer-events: none;
    }

    /* ═══════════════════════════════════════════════════════════ */
    /* 🚫 ICONO                                                    */
    /* El PNG viene en negro sobre fondo transparente, así que se  */
    /* usa como máscara y el color lo pone el CSS.                 */
    /* ═══════════════════════════════════════════════════════════ */
    .icono-sin-ninos {
        width: 4rem;
        aspect-ratio: 978 / 967;
        background-color: var(--verde);
        -webkit-mask: url("/imagenes/restriccion.png") center / contain no-repeat;
        mask: url("/imagenes/restriccion.png") center / contain no-repeat;
    }

    @media (min-width: 9999px) {
        .icono-sin-ninos {
            width: 4.8rem;
        }
    }
</style>
