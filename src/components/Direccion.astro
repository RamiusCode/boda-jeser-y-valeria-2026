---
// Direccion.astro — Dónde se celebra la ceremonia religiosa
// ⚠️ Reemplazar `mapa` por el enlace exacto del pin cuando lo tengas.
const mapa =
    "https://www.google.com/maps/search/?api=1&query=Parroquia+Sagrado+Coraz%C3%B3n+de+Mar%C3%ADa+Equipetrol+Santa+Cruz+de+la+Sierra";
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- ⛪ SECCIÓN: DIRECCIÓN DE LA CEREMONIA                       -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-4 pb-12 sm:pt-5 sm:pb-16 md:pt-6 md:pb-20">
    <div class="max-w-lg mx-auto px-6 sm:px-8 flex flex-col items-center">
        <!-- TARJETA -->
        <div
            data-revelar="escala"
            class="opacity-0 tarjeta-blanca relative w-full px-6 pt-10 pb-9 sm:px-10 sm:pt-12 sm:pb-11 flex flex-col items-center text-center"
        >
            <!-- FILETE INTERIOR -->
            <span class="tarjeta-blanca-filete"></span>

            <!-- TÍTULO -->
            <h2
                class="relative titulo-seccion text-center text-[1.1rem] sm:text-[1.35rem] md:text-[1.5rem] tracking-normal"
            >
                Ceremonia religiosa
            </h2>

            <!-- ICONO -->
            <div
                class="icono-iglesia relative mt-7 sm:mt-9"
                role="img"
                aria-label="Iglesia"
            >
            </div>

            <!-- PARROQUIA -->
            <h3
                class="relative texto-invitacion uppercase mt-5 sm:mt-6 text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.1em] leading-[1.6] text-[var(--champan)]"
            >
                Parroquia Sagrado<br class="sm:hidden" /> Coraz&oacute;n de Mar&iacute;a
            </h3>

            <!-- DIRECCIÓN -->
            <p
                class="relative texto-invitacion uppercase mt-2 sm:mt-2.5 text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.06em] leading-[1.7] text-[var(--verde-hondo)]"
            >
                Equipetrol, Av. San Mart&iacute;n<br /> Calle La Plata 8 Este
            </p>

            <!-- HORA -->
            <p
                class="relative font-trajan text-[var(--champan)] mt-4 sm:mt-5 text-[0.88rem] sm:text-[1.05rem] md:text-[1.15rem] leading-none"
            >
                16:30 <span class="tracking-[0.1em]"
                    >HORAS</span
                >
            </p>
            <!-- BOTÓN -->
            <a
                href={mapa}
                target="_blank"
                rel="noopener noreferrer"
                class="relative texto-invitacion uppercase mt-7 sm:mt-8 text-[0.66rem] sm:text-[0.75rem] tracking-[0.24em] text-white bg-[var(--verde-hondo)] rounded-[6px] px-8 sm:px-11 py-3 sm:py-3.5 transition-colors duration-300 hover:bg-[var(--verde)]"
            >
                Ver ubicaci&oacute;n
            </a>
        </div>
    </div>
</section>

<style>
    /* ═══════════════════════════════════════════════════════════ */
    /* ⛪ ICONO                                                    */
    /* El PNG viene en negro sobre fondo transparente, así que se  */
    /* usa como máscara y el color lo pone el CSS. Para cambiarlo, */
    /* toca solo `background-color`.                               */
    /* ═══════════════════════════════════════════════════════════ */
    .icono-iglesia {
        width: 3.6rem;
        aspect-ratio: 1;
        background-color: var(--verde);
        -webkit-mask: url("/imagenes/iglesia.png") center / contain no-repeat;
        mask: url("/imagenes/iglesia.png") center / contain no-repeat;
    }

    @media (min-width: 9999px) {
        .icono-iglesia {
            width: 4.4rem;
        }
    }
</style>
