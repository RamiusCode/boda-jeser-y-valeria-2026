---
// Sugerencia.astro — Sugerencia de regalos, QR y lluvia de sobres
// Sin tarjeta: va directo sobre el papel, con ornamentos de papelería.
// ⚠️ Reemplazar /imagenes/qr.png por el QR real de la lista de regalos.
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 🎁 SECCIÓN: SUGERENCIA DE REGALOS                           -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-4 pb-4 sm:pt-5 sm:pb-5 md:pt-6 md:pb-6">
    <div
        class="max-w-lg mx-auto px-6 sm:px-8 flex flex-col items-center text-center"
    >
        <!-- TÍTULO -->
        <h2
            data-revelar="abajo"
            class="opacity-0 titulo-seccion text-center text-[1.1rem] sm:text-[1.35rem] md:text-[1.5rem] tracking-normal"
        >
            Sugerencia de regalos
        </h2>

        <!-- ICONO -->
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 48 48"
            fill="none"
            aria-hidden="true"
            data-revelar="escala"
            data-retraso="0.12"
            class="opacity-0 mt-7 sm:mt-9 w-[3.6rem] h-[3.6rem] sm:w-[4.4rem] sm:h-[4.4rem]"
        >
            <rect
                x="6"
                y="17"
                width="36"
                height="8"
                stroke="var(--verde)"
                stroke-width="1.6"></rect>
            <rect
                x="9.5"
                y="25"
                width="29"
                height="17"
                stroke="var(--verde)"
                stroke-width="1.6"></rect>
            <line
                x1="24"
                y1="17"
                x2="24"
                y2="42"
                stroke="var(--verde)"
                stroke-width="1.6"></line>
            <path
                d="M24 17c-3-1-9-2.5-9-6.5 0-2 1.6-3.5 3.6-3.5 3.4 0 5.4 4.6 5.4 10z"
                stroke="var(--verde)"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
            <path
                d="M24 17c3-1 9-2.5 9-6.5 0-2-1.6-3.5-3.6-3.5-3.4 0-5.4 4.6-5.4 10z"
                stroke="var(--verde)"
                stroke-width="1.6"
                stroke-linejoin="round"></path>
        </svg>

        <!-- INTRODUCCIÓN -->
        <p
            data-revelar="abajo"
            data-retraso="0.2"
            class="opacity-0 texto-invitacion uppercase mt-5 sm:mt-6 text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.12em] leading-[1.7] text-[var(--verde-hondo)]"
        >
            &iexcl;Su presencia es el mejor regalo!<br /> En caso que deseen hacernos
            un obsequio<br /> les damos las siguientes opciones
        </p>

        <!-- ═══ OPCIÓN I ═══ -->
        <div class="ornamento opacity-0" data-revelar="abajo">
            <span class="ornamento-linea"></span>
            <span class="ornamento-rombo"></span>
            <span class="ornamento-linea"></span>
        </div>

        <h3
            data-revelar="abajo"
            data-retraso="0.08"
            class="opacity-0 texto-invitacion uppercase text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.1em] leading-[1.6] text-[var(--champan)]"
        >
            Mesa de regalos
        </h3>

        <!-- CÓDIGO QR CON ESQUINAS -->
        <div
            data-revelar="escala"
            data-retraso="0.16"
            class="opacity-0 relative mt-6 sm:mt-7 p-4 sm:p-5"
        >
            <span class="esquina esquina-si"></span>
            <span class="esquina esquina-sd"></span>
            <span class="esquina esquina-ii"></span>
            <span class="esquina esquina-id"></span>

            <img
                src="/imagenes/qr.png"
                alt="C&oacute;digo QR de la mesa de regalos"
                class="w-36 h-36 sm:w-44 sm:h-44 object-contain"
                loading="lazy"
            />
        </div>

        <p
            data-revelar="abajo"
            data-retraso="0.22"
            class="opacity-0 texto-invitacion uppercase mt-4 text-[0.66rem] sm:text-[0.75rem] tracking-[0.2em] text-[var(--verde-hondo)]"
        >
            Escanea el c&oacute;digo
        </p>

        <!-- ═══ OPCIÓN II ═══ -->
        <div class="ornamento opacity-0" data-revelar="abajo">
            <span class="ornamento-linea"></span>
            <span class="ornamento-rombo"></span>
            <span class="ornamento-linea"></span>
        </div>

        <h3
            data-revelar="abajo"
            data-retraso="0.08"
            class="opacity-0 texto-invitacion uppercase text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.1em] leading-[1.6] text-[var(--champan)]"
        >
            Lluvia de sobres
        </h3>

        <p
            data-revelar="abajo"
            data-retraso="0.16"
            class="opacity-0 texto-invitacion uppercase mt-2 sm:mt-2.5 text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.06em] leading-[1.7] text-[var(--verde-hondo)]"
        >
            Tendremos un buz&oacute;n de sobres<br /> por si quieres depositar tu
            regalo
        </p>

        <!-- LOGO CELEBRACIONES MULTICENTER -->
        <div
            data-revelar="escala"
            data-retraso="0.24"
            class="opacity-0 mt-7 sm:mt-8"
        >
            <div
                class="logo-multicenter"
                role="img"
                aria-label="Celebraciones Multicenter"
            >
            </div>
        </div>
    </div>
</section>

<style>
    /* ═══════════════════════════════════════════════════════════ */
    /* ◇ ORNAMENTO — filete con rombo al centro                    */
    /* El separador clásico de la papelería fina: dos hilos y una  */
    /* pieza girada 45°. Marca el corte sin pesar en la página.    */
    /* ═══════════════════════════════════════════════════════════ */
    .ornamento {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.7rem;
        width: 100%;
        max-width: 15rem;
        margin: 2.75rem 0 1.75rem;
    }

    .ornamento-linea {
        flex: 1;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--champan-tenue) 25%,
            var(--champan) 100%
        );
    }

    .ornamento-linea:last-of-type {
        background: linear-gradient(
            to left,
            transparent,
            var(--champan-tenue) 25%,
            var(--champan) 100%
        );
    }

    .ornamento-rombo {
        width: 5px;
        height: 5px;
        flex-shrink: 0;
        background-color: var(--champan);
        transform: rotate(45deg);
    }

    @media (min-width: 9999px) {
        .ornamento {
            margin: 3.25rem 0 2rem;
        }
    }

    /* ═══════════════════════════════════════════════════════════ */
    /* ⌐ ESQUINAS DEL QR                                           */
    /* Cuatro escuadras en vez de un marco cerrado: enmarca el     */
    /* código sin encerrarlo, y deja el QR limpio para el lector.  */
    /* ═══════════════════════════════════════════════════════════ */
    .esquina {
        position: absolute;
        width: 14px;
        height: 14px;
        pointer-events: none;
    }

    .esquina-si {
        top: 0;
        left: 0;
        border-top: 1px solid var(--champan);
        border-left: 1px solid var(--champan);
    }

    .esquina-sd {
        top: 0;
        right: 0;
        border-top: 1px solid var(--champan);
        border-right: 1px solid var(--champan);
    }

    .esquina-ii {
        bottom: 0;
        left: 0;
        border-bottom: 1px solid var(--champan);
        border-left: 1px solid var(--champan);
    }

    .esquina-id {
        bottom: 0;
        right: 0;
        border-bottom: 1px solid var(--champan);
        border-right: 1px solid var(--champan);
    }

    @media (min-width: 9999px) {
        .esquina {
            width: 18px;
            height: 18px;
        }
    }

    /* ═══════════════════════════════════════════════════════════ */
    /* 🏬 LOGO CELEBRACIONES MULTICENTER                           */
    /* El PNG viene en negro sobre fondo transparente, así que se  */
    /* usa como máscara y el color lo pone el CSS.                 */
    /* ═══════════════════════════════════════════════════════════ */
    .logo-multicenter {
        width: 10rem;
        aspect-ratio: 430 / 118;
        background-color: var(--verde-hondo);
        -webkit-mask: url("/imagenes/logo-alpha.png") center / contain no-repeat;
        mask: url("/imagenes/logo-alpha.png") center / contain no-repeat;
    }

    @media (min-width: 9999px) {
        .logo-multicenter {
            width: 12.5rem;
        }
    }
</style>
