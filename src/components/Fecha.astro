---
// Fecha.astro — Invitación a la ceremonia y fecha
// La parroquia y su dirección van en un componente aparte.
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📅 SECCIÓN: FECHA                                           -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full pt-4 pb-4 sm:pt-5 sm:pb-5 md:pt-6 md:pb-6">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 text-center">
        <!-- INVITACIÓN -->
        <p
            data-revelar="abajo"
            class="opacity-0 texto-invitacion uppercase text-[0.76rem] sm:text-[0.92rem] md:text-[0.99rem] tracking-[0.06em] leading-[2]"
        >
            Consagramos nuestra uni&oacute;n y tenemos el placer<br
                class="hidden sm:block"
            /> de invitarlos a la ceremonia que se celebrar&aacute; el
        </p>

        <!-- AÑO -->
        <p
            data-revelar="abajo"
            data-retraso="0.12"
            class="opacity-0 font-trajan text-[var(--champan)] mt-8 sm:mt-10 text-[1.05rem] sm:text-[1.25rem] md:text-[1.4rem] tracking-[0.34em] indent-[0.34em] leading-none"
        >
            2026
        </p>

        <!-- FILA: SÁBADO | 19 | DICIEMBRE -->
        <div
            data-revelar="abajo"
            data-retraso="0.2"
            class="opacity-0 mt-5 sm:mt-7 flex items-center justify-center gap-3 sm:gap-5"
        >
            <!-- DÍA DE LA SEMANA, ENTRE FILETES -->
            <div class="flex flex-col items-center flex-1 gap-1.5">
                <span class="h-px w-full bg-[var(--champan-tenue)]"></span>
                <span
                    class="texto-invitacion uppercase py-1 text-[0.88rem] sm:text-[1.05rem] md:text-[1.15rem] tracking-[0.16em] text-[var(--verde-hondo)] whitespace-nowrap"
                >
                    S&aacute;bado
                </span>
                <span class="h-px w-full bg-[var(--champan-tenue)]"></span>
            </div>

            <!-- DÍA -->
            <span
                class="font-trajan text-[var(--champan)] shrink-0 leading-none px-3 sm:px-5 text-[2.6rem] sm:text-[3.4rem] md:text-[3.9rem]"
            >
                19
            </span>

            <!-- MES, ENTRE FILETES -->
            <div class="flex flex-col items-center flex-1 gap-1.5">
                <span class="h-px w-full bg-[var(--champan-tenue)]"></span>
                <span
                    class="texto-invitacion uppercase py-1 text-[0.88rem] sm:text-[1.05rem] md:text-[1.15rem] tracking-[0.16em] text-[var(--verde-hondo)] whitespace-nowrap"
                >
                    Diciembre
                </span>
                <span class="h-px w-full bg-[var(--champan-tenue)]"></span>
            </div>
        </div>

        <!-- HORA -->
        <p
            data-revelar="abajo"
            data-retraso="0.3"
            class="opacity-0 font-trajan text-[var(--verde-hondo)] mt-6 sm:mt-8 text-[0.88rem] sm:text-[1.05rem] md:text-[1.15rem] leading-none"
        >
            16:30 <span class="tracking-[0.1em] text-[var(--verde-hondo)]"
                >HORAS</span
            >
        </p>

        <!-- ICONO CALENDARIO -->
        <div
            data-revelar="escala"
            data-retraso="0.4"
            class="opacity-0 flex justify-center mt-7 sm:mt-9"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 42 42"
                fill="none"
                aria-hidden="true"
                class="w-9 h-9 sm:w-11 sm:h-11"
            >
                <rect
                    x="3"
                    y="8"
                    width="36"
                    height="30"
                    stroke="var(--verde)"
                    stroke-width="1.4"></rect>
                <line
                    x1="3"
                    y1="17"
                    x2="39"
                    y2="17"
                    stroke="var(--verde)"
                    stroke-width="1.4"></line>
                <line
                    x1="13"
                    y1="3"
                    x2="13"
                    y2="12"
                    stroke="var(--verde)"
                    stroke-width="1.6"
                    stroke-linecap="round"></line>
                <line
                    x1="29"
                    y1="3"
                    x2="29"
                    y2="12"
                    stroke="var(--verde)"
                    stroke-width="1.6"
                    stroke-linecap="round"></line>
                <path
                    d="M21 31 C21 31 14.5 26.8 14.5 23 C14.5 21.1 16 20 17.8 20 C19.2 20 20.3 20.8 21 22 C21.7 20.8 22.8 20 24.2 20 C26 20 27.5 21.1 27.5 23 C27.5 26.8 21 31 21 31Z"
                    fill="var(--champan)"></path>
            </svg>
        </div>
    </div>
</section>
