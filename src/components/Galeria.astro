---
// Galeria.astro
// ⚠️ Im\u00e1genes de referencia: reempl\u00e1zalas por las fotos de Jeser y Valeria
//    manteniendo los mismos nombres de archivo en /public/imagenes.
const fotos = [
    { src: "/imagenes/foto1.png", alt: "Jeser y Valeria" },
    { src: "/imagenes/foto2.png", alt: "Jeser y Valeria" },
    { src: "/imagenes/foto3.png", alt: "Jeser y Valeria" },
    { src: "/imagenes/foto4.png", alt: "Jeser y Valeria" },
    { src: "/imagenes/foto5.png", alt: "Jeser y Valeria" },
    { src: "/imagenes/foto.png", alt: "Jeser y Valeria" },
];
---

<!-- ═══════════════════════════════════════════════════════════ -->
<!-- 📷 SECCIÓN: GALERÍA                                         -->
<!-- ═══════════════════════════════════════════════════════════ -->
<section class="relative w-full py-12 sm:py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-5 sm:px-8">
        <!-- TÍTULO -->
        <h2
            data-revelar="abajo"
            class="opacity-0 titulo-seccion text-center text-[1.9rem] sm:text-[2.6rem] md:text-[3.1rem]"
        >
            Nuestra historia
        </h2>

        <div class="w-16 sm:w-20 mx-auto mt-5 sm:mt-6">
            <div class="regla" data-linea></div>
        </div>

        <!-- CUADRÍCULA -->
        <div
            class="mt-10 sm:mt-14 grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-5"
        >
            {
                fotos.map((foto, i) => (
                    <button
                        type="button"
                        data-revelar="escala"
                        data-retraso={(i * 0.07).toFixed(2)}
                        data-foto={foto.src}
                        class="galeria-item opacity-0 group relative block w-full aspect-[3/4] overflow-hidden border border-[var(--champan-tenue)] bg-white cursor-zoom-in"
                    >
                        <img
                            src={foto.src}
                            alt={foto.alt}
                            loading="lazy"
                            class="w-full h-full object-cover grayscale contrast-[1.05] transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:scale-[1.04]"
                        />
                    </button>
                ))
            }
        </div>
    </div>
</section>

<!-- VISOR AMPLIADO -->
<div
    id="galeria-visor"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-white/97 p-5 sm:p-10 cursor-zoom-out"
>
    <img
        id="galeria-visor-img"
        src=""
        alt="Foto ampliada"
        class="max-w-full max-h-full object-contain border border-[var(--champan-tenue)]"
    />
    <button
        id="galeria-cerrar"
        aria-label="Cerrar"
        class="absolute top-5 right-6 sm:top-8 sm:right-10 texto-invitacion uppercase text-[0.66rem] sm:text-[0.75rem] tracking-[0.24em] text-[var(--champan)]"
    >
        Cerrar
    </button>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const visor = document.getElementById("galeria-visor");
        const visorImg = document.getElementById(
            "galeria-visor-img",
        ) as HTMLImageElement | null;

        if (!visor || !visorImg) return;

        const abrir = (src: string) => {
            visorImg.src = src;
            visor.classList.remove("hidden");
            visor.classList.add("flex");
            document.body.style.overflow = "hidden";
        };

        const cerrar = () => {
            visor.classList.add("hidden");
            visor.classList.remove("flex");
            document.body.style.overflow = "auto";
        };

        document
            .querySelectorAll<HTMLElement>(".galeria-item")
            .forEach((item) => {
                item.addEventListener("click", () => {
                    const src = item.dataset.foto;
                    if (src) abrir(src);
                });
            });

        visor.addEventListener("click", cerrar);
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") cerrar();
        });
    });
</script>
